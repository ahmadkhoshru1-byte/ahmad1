{
  "name": "zabihi-facilities",
  "version": "1.0.0",
  "description": "گروه تأسیسات ذبیحی",
  "author": "Khoshro",
  "main": "main.js",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.khoshro.zabihi",
    "productName": "ZabihiFacilities",
    "files": ["main.js", "index.html", "icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "گروه تأسیسات ذبیحی",
      "artifactName": "ZabihiFacilities-Setup-${version}.${ext}"
    }
  }
}
